        //ejecuta una sentencia sql
        //regresa un objeto datatable
        #region getValues
        public DataTable getValues(string query)
        {
            DataTable ds = new DataTable();
            establecerConexion();
            try
            {
                comando = new SqlCommand(query, conexion);
                comando.CommandType = CommandType.Text;
                comando.CommandTimeout = 72000;
                conexion.Open();
                resultados = comando.ExecuteReader();

                if (resultados.HasRows)
                {
                    ds.Load(resultados, LoadOption.OverwriteChanges);
                }
                this.conexion.Close();
            }
            catch (Exception ex)
            {

                //throw new Exception(ex.Message);

            }
            return ds;
        }
        #endregion

