                return false;
            }
        }
        public bool eliminarFraccion(int idCorreo, int idUsuario)
        {
            establecerConexion();

            comando = new SqlCommand("sp_eliminarFraccion", conexion);
            comando.CommandType = CommandType.StoredProcedure;
            comando.Parameters.Add("@idCorreo", SqlDbType.Int).Value = idCorreo;

            comando.Parameters.Add("@idUsuario", SqlDbType.Int).Value = idUsuario;
            try
            {
                conexion.Open();
                comando.ExecuteNonQuery();
                conexion.Close();
                return true;
            }
            catch (SqlException e)
            {
                return false;
            }
        }

        public string construirMenu(int idUsuario, int idSeccion, string idSistema, string idUs, int opcion, string encSeccion)
        {
            establecerConexion();
            if (opcion == 1)
            {
                comando = new SqlCommand("sp_menuH", conexion);
            }
            else if (opcion == 2)
            {
                comando = new SqlCommand("sp_menuC", conexion);
            }
            comando.CommandType = CommandType.StoredProcedure;

            comando.Parameters.Add("@idUsuario", SqlDbType.Int).Value = idUsuario;
            comando.Parameters.Add("@idSeccion", SqlDbType.Int).Value = idSeccion;
            comando.Parameters.Add("@idSistema", SqlDbType.VarChar).Value = idSistema;
            comando.Parameters.Add("@idUs", SqlDbType.VarChar).Value = idUs;
            comando.Parameters.Add("@encSeccion", SqlDbType.VarChar).Value = encSeccion;

            string result = "";

            try
            {
                conexion.Open();
                resultados = comando.ExecuteReader();
                while (resultados.Read())
                {
                    result = resultados.GetValue(0).ToString();
                }
                conexion.Close();

                return result;
            }
            catch (SqlException e)
            {
                return e.Message.ToString();
            }
        }

        #region Llamada al Procedimiento de Altas ,Bajas y Actualizaciones para Credenciales VUCEM
        public string GuardarCredencial(int idCredencial, string password, string archivoCer, string archivoKey, string contrasenaField, string rfc, int accion)
        {
            string respuesta = "";

            try
            {
                SqlDataReader read = null;
                establecerConexion();
                comando = new SqlCommand("spGuardaCredencial", conexion);

                comando.CommandType = CommandType.StoredProcedure;

                comando.Parameters.Add("@idCredencial", SqlDbType.Int).Value = idCredencial;
                comando.Parameters.Add("@passwordVUCEM", SqlDbType.VarChar).Value = password;
                comando.Parameters.Add("@archivoCer", SqlDbType.VarChar).Value = archivoCer;
                comando.Parameters.Add("@archivoKey", SqlDbType.VarChar).Value = archivoKey;
                comando.Parameters.Add("@contrasenaField", SqlDbType.VarChar).Value = contrasenaField;
                comando.Parameters.Add("@rfc", SqlDbType.VarChar).Value = rfc;
                //comando.Parameters.Add("@idUsuario", SqlDbType.Int).Value = accion;
                comando.Parameters.Add("@accion", SqlDbType.Int).Value = accion;

                conexion.Open();
                read = comando.ExecuteReader();
                if (read.HasRows)
                {
                    while (read.Read())
                    {
                        respuesta = read.GetValue(0).ToString();
                    }
                    return respuesta;
                }
                else
                {
                    return respuesta;
                }
            }
            catch (SqlException ex)
            {
                return respuesta = "Error Datos no Validos";
            }
            finally
            {
                if (comando != null)
                {
                    comando.Dispose();
                    conexion.Close();
                }
            }

        }

        #endregion

